	while screenGui.Parent do
		local pulse = math.sin(tick() * 2) * 0.5 + 0.5
		buttonGradient.Offset = Vector2.new(0, 0.2 + pulse * 0.6)
		iconScale.Scale = 1 + pulse * 0.06
		RunService.RenderStepped:Wait()
	end
end)

