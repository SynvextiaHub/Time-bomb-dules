--// clipboard: try every method available, count the successes
local function copyToClipboard(text: string): number
	local ok = 0

	if type(setclipboard) == "function" then
		ok += pcall(setclipboard, text) and 1 or 0
	end
	if type(writeclipboard) == "function" then
		ok += pcall(writeclipboard, text) and 1 or 0
	end
	ok += pcall(function()
		GuiService:SetClipboard(text)
	end) and 1 or 0
	ok += pcall(function()
		GuiService:CopyToClipboard(text)
	end) and 1 or 0
	ok += pcall(function()
		player:SetClipboard(text)
	end) and 1 or 0

	return ok
end

local busy = false

button.MouseButton1Click:Connect(function()
	if busy then
		return
	end
	busy = true

	local copied = copyToClipboard(INVITE)

	-- keyboard fallback: put the link in a focused box so ctrl+v still works
	linkBox.Text = INVITE
	linkBox:ReleaseFocus()

	if copied > 0 then
		button.Text = "Copied to clipboard!"
		buttonGradient.Color = ColorSequence.new(
			Color3.fromRGB(52, 168, 104),
			COL_SUCCESS
		)
		button.BackgroundColor3 = COL_SUCCESS
	else
		button.Text = "Press CTRL+V"
		buttonGradient.Color = ColorSequence.new(
			Color3.fromRGB(120, 130, 255),
			COL_ACCENT
		)
		button.BackgroundColor3 = COL_ACCENT
	end

	TweenService:Create(icon, TweenInfo.new(0.2), { ImageTransparency = 0.45 }):Play()
	task.wait(0.15)
	TweenService:Create(icon, TweenInfo.new(0.2), { ImageTransparency = 0 }):Play()

	task.wait(1.6)

	button.Text = "Join server"
	button.BackgroundColor3 = COL_ACCENT
	buttonGradient.Color = ColorSequence.new(COL_ACCENT_HOVER, COL_ACCENT)
	linkBox.Text = ""
	busy = false
end)

--// idle pulse so the button is hard to miss
